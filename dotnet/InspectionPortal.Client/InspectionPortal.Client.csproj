<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>InspectionPortal.Client</PackageId>
    <Version>1.0.0</Version>
    <Description>Typed .NET client for the SAP-HFIR Inspection Portal API.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../lib/api-spec/openapi.yaml" Link="openapi.yaml" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="contentFiles/any/any/" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
